{% extends 'base.html.twig' %}

{% block title %}
    {{ (isEdit ?? false) ? 'Modifier une sortie' : 'Créer une sortie' }} - Sortir.com
{% endblock %}

{% block body %}
    <div class="card card-form shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="h4 mb-0 fw-bold">
                {{ (isEdit ?? false) ? 'Modifier la sortie' : 'Créer une sortie' }}
            </h2>
        </div>

        {# 1. ON ATTACHE LE CONTROLEUR STIMULUS "lieu" ICI #}
        <div class="card-body" data-controller="lieu">

            {{ form_start(sortieForm) }}
            {{ form_errors(sortieForm) }}

            <div class="row">
                {# Colonne de gauche #}
                <div class="col-md-6">
                    <div class="mb-3">{{ form_row(sortieForm.nom) }}</div>
                    <div class="mb-3">{{ form_row(sortieForm.dateHeureDebut) }}</div>
                    <div class="mb-3">{{ form_row(sortieForm.dateLimiteInscription) }}</div>
                    <div class="mb-3">{{ form_row(sortieForm.nbInscriptionsMax) }}</div>
                    <div class="mb-3">{{ form_row(sortieForm.duree) }}</div>
                </div>

                {# Colonne de droite #}
                <div class="col-md-6">
                    <div class="mb-3">{{ form_row(sortieForm.siteOrganisateur) }}</div>

                    {# 2. ACTION STIMULUS AU CHANGEMENT DU LIEU #}
                    <div class="mb-3">
                        {{ form_row(sortieForm.lieu, {
                            'attr': {'data-action': 'change->lieu#update'}
                        }) }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="lieu-rue">Rue</label>
                        <input type="text" id="lieu-rue" class="form-control bg-light" readonly
                               placeholder="Sélectionnez un lieu">
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="lieu-code-postal">Code postal</label>
                        <input type="text" id="lieu-code-postal" class="form-control bg-light" readonly
                               placeholder="Sélectionnez un lieu">
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="lieu-lat-lng">Latitude / Longitude</label>
                        <input type="text" id="lieu-lat-lng" class="form-control bg-light" readonly
                               placeholder="Sélectionnez un lieu">
                    </div>
                </div>
            </div>

            <div class="mb-4">
                {{ form_row(sortieForm.infoSortie) }}
            </div>

            <hr class="my-4">

            {# Boutons #}
            <div class="row g-2 justify-content-end align-items-center">
                {# On affiche les boutons Enregistrer/Publier si on est en création (isEdit est faux) ou si on a le droit de modifier #}
                {% if not (isEdit ?? false) or (sortie is defined and sortie.isModifiableBy(app.user)) %}
                    <div class="col-md-3">{{ form_widget(sortieForm.enregistrer) }}</div>
                    <div class="col-md-3">{{ form_widget(sortieForm.publier) }}</div>
                {% endif %}

                {# On affiche le bouton de suppression uniquement si la sortie est définie et supprimable par l'utilisateur connecté #}
                {% if (isEdit ?? false) and sortie is defined and sortie.isSupprimableBy(app.user) %}
                    <div class="col-md-3">
                        <button type="button" class="btn btn-danger w-100"
                                onclick="if(confirm('Êtes-vous sûr ?')) { document.getElementById('delete-form').submit(); }">
                            Supprimer la sortie
                        </button>
                    </div>
                {% endif %}

                <div class="col-md-3">
                    <a href="#" class="btn btn-outline-secondary w-100">Retour à la liste</a>
                </div>
            </div>

            {{ form_end(sortieForm) }}

            {% if (isEdit ?? false) and sortie.isSupprimableBy(userConnected) %}
                <form method="post" action="{{ path('app_sortie_supprimer', {'id': sortie.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette sortie ?');" id="delete-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sortie.id) }}">
                    <button type="submit" class="btn btn-danger w-100">Supprimer la sortie</button>
                </form>
            {% endif %}

        </div>
    </div>
{% endblock %}
