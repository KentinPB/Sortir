{% extends 'base.html.twig' %}

{% block title %}
    {{ (isEdit ?? false) ? 'Modifier une sortie' : 'Créer une sortie' }} | {{ parent() }}
{% endblock %}

{% block body %}
    <div class="card card-form shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="h4 mb-0 fw-bold">
                {{ (isEdit ?? false) ? 'Modifier la sortie' : 'Créer une sortie' }}
            </h2>
        </div>

        {# 1. ON ATTACHE LE CONTROLEUR STIMULUS "lieu" ICI #}
        <div class="card-body" data-controller="lieu">

            {{ form_start(sortieForm) }}
            {{ form_errors(sortieForm) }}

            <div class="row">
                {# Colonne de gauche #}
                <div class="col-md-6">
                    <div class="mb-3">{{ form_row(sortieForm.nom) }}</div>
                    <div class="mb-3">{{ form_row(sortieForm.dateHeureDebut) }}</div>
                    <div class="mb-3">{{ form_row(sortieForm.dateLimiteInscription) }}</div>
                    <div class="mb-3">{{ form_row(sortieForm.nbInscriptionsMax) }}</div>
                    <div class="mb-3">{{ form_row(sortieForm.duree) }}</div>
                </div>

                {# Colonne de droite #}
                <div class="col-md-6">
                    <div class="mb-3">{{ form_row(sortieForm.siteOrganisateur) }}</div>

                    {# 2. ACTION STIMULUS AU CHANGEMENT DU LIEU #}
                    <div class="mb-3">
                        {{ form_row(sortieForm.lieu, {
                            'attr': {'data-action': 'change->lieu#update'}
                        }) }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="lieu-rue">Rue</label>
                        <input type="text" id="lieu-rue" class="form-control bg-light" readonly
                               placeholder="Sélectionnez un lieu">
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="lieu-code-postal">Code postal</label>
                        <input type="text" id="lieu-code-postal" class="form-control bg-light" readonly
                               placeholder="Sélectionnez un lieu">
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="lieu-lat-lng">Latitude / Longitude</label>
                        <input type="text" id="lieu-lat-lng" class="form-control bg-light" readonly
                               placeholder="Sélectionnez un lieu">
                    </div>
                </div>
            </div>

            <div class="mb-4">
                {{ form_row(sortieForm.infoSortie) }}
            </div>

            <hr class="my-4">

            {# Zone des boutons d'action alignés et centrés #}
            <div class="d-flex flex-wrap justify-content-center gap-2">
                {# Condition pour Enregistrer / Publier #}
                {% if not (isEdit ?? false) or (sortie is defined and sortie.isModifiableBy(app.user ?? userConnected ?? null)) %}
                    {{ form_widget(sortieForm.enregistrer, {'attr': {'class': 'btn btn-primary'}}) }}
                    {{ form_widget(sortieForm.publier, {'attr': {'class': 'btn btn-primary'}}) }}
                {% endif %}

                {# Bouton Supprimer (affiché uniquement en édition si la sortie est supprimable) #}
                {% if (isEdit ?? false) and sortie is defined and sortie.isSupprimableBy(app.user ?? userConnected ?? null) %}
                    <button type="button"
                            class="btn btn-danger"
                            onclick="if(confirm('Êtes-vous sûr de vouloir supprimer cette sortie ?')) { document.getElementById('delete-form').submit(); }">
                        Supprimer la sortie
                    </button>
                {% endif %}

                {# Bouton Retour #}
                <a href="{{ path('accueil') }}" class="btn btn-secondary">Annuler</a>
            </div>

            {{ form_end(sortieForm) }}

            {# Formulaire caché pour la suppression sécurisée CSRF #}
            {% if (isEdit ?? false) and sortie is defined and sortie.isSupprimableBy(app.user ?? userConnected ?? null) %}
                <form method="post"
                      action="{{ path('app_sortie_delete', {'id': sortie.id}) }}"
                      id="delete-form"
                      class="d-none">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sortie.id) }}">
                </form>
            {% endif %}

        </div> {# Fin card-body #}
    </div> {# Fin card #}
{% endblock %}
