{% extends 'base.html.twig' %}

{% block title %}Annuler une sortie | {{ parent() }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Annuler une sortie</h1>

        <div class="card mb-4">
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-12 col-sm-3 fw-bold">Nom de la sortie :</div>
                    <div class="col-12 col-sm-9">{{ sortie.nom }}</div>
                </div>
                <div class="row mb-2">
                    <div class="col-12 col-sm-3 fw-bold">Date de la sortie :</div>
                    <div class="col-12 col-sm-9">{{ sortie.dateHeureDebut|date('d/m/Y H:i') }}</div>
                </div>
                <div class="row mb-2">
                    <div class="col-12 col-sm-3 fw-bold">Campus :</div>
                    <div class="col-12 col-sm-9">{{ sortie.siteOrganisateur ? sortie.siteOrganisateur.nom : '' }}</div>
                </div>
                <div class="row mb-2">
                    <div class="col-12 col-sm-3 fw-bold">Lieu :</div>
                    <div class="col-12 col-sm-9">
                        {{ sortie.lieu ? sortie.lieu.nom : '' }}
                        ({{ sortie.lieu and sortie.lieu.ville ? sortie.lieu.ville.nom : '' }})
                    </div>
                </div>
            </div>
        </div>

        {{ form_start(form) }}
        <div class="mb-3">
            {{ form_label(form.motifAnnulation, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
            {{ form_widget(form.motifAnnulation, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.motifAnnulation) }}
        </div>

        <div class="d-flex flex-column flex-sm-row justify-content-center align-items-center gap-2 mt-4">
            <button type="submit" class="btn btn-danger w-100 w-sm-auto">Enregistrer l'annulation</button>
            <a href="{{ path('accueil') }}" class="btn btn-secondary w-100 w-sm-auto">Annuler / Retour</a>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
