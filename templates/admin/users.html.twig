{% extends 'base.html.twig' %}

{% block title %}
    Gérer les utilisateurs | {{ parent() }}
{% endblock %}

{% block body %}
    <div class="container-fluid px-4 my-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Gérer les utilisateurs</h1>
            <a href="{{ path('app_admin_users_add') }}" class="btn btn-success">
                <i class="bi bi-person-plus"></i> Ajouter un utilisateur
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                <tr>
                    <th class="text-nowrap">Campus</th>
                    <th>Pseudo</th>
                    <th>Prénom</th>
                    <th>Nom</th>
                    <th>Téléphone</th>
                    <th>Email</th>
                    <th class="text-nowrap" style="min-width: 90px;">Actif</th>
                    <th class="text-nowrap">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td class="text-nowrap">{{ user.campus ? user.campus.nom : '' }}</td>
                        <td>{{ user.pseudo }}</td>
                        <td>{{ user.prenom }}</td>
                        <td>{{ user.nom }}</td>
                        <td class="text-nowrap">{{ user.telephone }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.actif ? 'Oui' : 'Non' }}</td>
                        <td class="text-nowrap">
                            <div class="d-flex gap-1">
                                <a href="{{ path('app_admin_users_edit', {'id': user.id}) }}"
                                   class="btn btn-sm btn-primary">Modifier</a>

                                {# Formulaire d'activation / désactivation #}
                                <form method="POST"
                                      action="{{ path('app_admin_users_toggle_active', {'id': user.id}) }}"
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir {{ user.actif ? 'désactiver' : 'activer' }} le compte de {{ user.pseudo }} ?');">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('toggle_active_' ~ user.id) }}">
                                    {% if user.actif %}
                                        <button type="submit" class="btn btn-sm btn-danger">Désactiver</button>
                                    {% else %}
                                        <button type="submit" class="btn btn-sm btn-success">Activer</button>
                                    {% endif %}
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
