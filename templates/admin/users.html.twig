{% extends 'base.html.twig' %}

{% block title %}
    Gérer les utilisateurs | {{ parent() }}
{% endblock %}

{% block body %}
    <div class="container-fluid px-4 my-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Gérer les utilisateurs</h1>
            <a href="{{ path('app_admin_users_add') }}" class="btn btn-success">
                <i class="bi bi-person-plus"></i> Ajouter un utilisateur
            </a>
        </div>

        {# ---------- Vista de tabla: solo visible desde md hacia arriba ---------- #}
        <div class="table-responsive d-none d-md-block">
            <table class="table table-striped table-hover align-middle">
                <thead>
                <tr>
                    <th class="text-nowrap">Campus</th>
                    <th>Pseudo</th>
                    <th>Prénom</th>
                    <th>Nom</th>
                    <th>Téléphone</th>
                    <th>Email</th>
                    <th class="text-nowrap" style="min-width: 90px;">Actif</th>
                    <th class="text-nowrap">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td class="text-nowrap">{{ user.campus ? user.campus.nom : '' }}</td>
                        <td>{{ user.pseudo }}</td>
                        <td>{{ user.prenom }}</td>
                        <td>{{ user.nom }}</td>
                        <td class="text-nowrap">{{ user.telephone }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.actif ? 'Oui' : 'Non' }}</td>
                        <td class="text-nowrap">
                            <div class="d-flex gap-1">
                                <a href="{{ path('app_admin_users_edit', {'id': user.id}) }}"
                                   class="btn btn-sm btn-primary">Modifier</a>
                                <form method="POST"
                                      action="{{ path('app_admin_users_toggle_active', {'id': user.id}) }}"
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir {{ user.actif ? 'désactiver' : 'activer' }} le compte de {{ user.pseudo }} ?');">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('toggle_active_' ~ user.id) }}">
                                    {% if user.actif %}
                                        <button type="submit" class="btn btn-sm btn-danger">Désactiver</button>
                                    {% else %}
                                        <button type="submit" class="btn btn-sm btn-success">Activer</button>
                                    {% endif %}
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {# ---------- Vista de tarjetas: solo visible por debajo de md ---------- #}
        <div class="d-md-none">
            {% for user in users %}
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">{{ user.prenom }} {{ user.nom }}</h5>
                            <span class="badge {{ user.actif ? 'bg-success' : 'bg-secondary' }}">
                                {{ user.actif ? 'Actif' : 'Inactif' }}
                            </span>
                        </div>
                        <p class="card-text mb-1"><strong>Pseudo :</strong> {{ user.pseudo }}</p>
                        <p class="card-text mb-1"><strong>Campus :</strong> {{ user.campus ? user.campus.nom : '' }}</p>
                        <p class="card-text mb-1"><strong>Téléphone :</strong> {{ user.telephone }}</p>
                        <p class="card-text mb-3"><strong>Email :</strong> {{ user.email }}</p>

                        <div class="d-flex gap-2">
                            <a href="{{ path('app_admin_users_edit', {'id': user.id}) }}"
                               class="btn btn-sm btn-primary flex-fill">Modifier</a>

                            <form method="POST"
                                  action="{{ path('app_admin_users_toggle_active', {'id': user.id}) }}"
                                  class="flex-fill"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir {{ user.actif ? 'désactiver' : 'activer' }} le compte de {{ user.pseudo }} ?');">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('toggle_active_' ~ user.id) }}">
                                {% if user.actif %}
                                    <button type="submit" class="btn btn-sm btn-danger w-100">Désactiver</button>
                                {% else %}
                                    <button type="submit" class="btn btn-sm btn-success w-100">Activer</button>
                                {% endif %}
                            </form>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
