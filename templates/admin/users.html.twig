{% extends 'base.html.twig' %}

{% block title %}
    Gérer les utilisateurs | {{ parent() }}
{% endblock %}

{% block body %}
    <div class="container-fluid px-4 my-4">
        <h1 class="mb-4">Gérer les utilisateurs</h1>

        <form action="{{ path('app_admin_users_add') }}" method="POST">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                    <tr>
                        <th class="text-nowrap">Campus</th>
                        <th>Pseudo</th>
                        <th>Prénom</th>
                        <th>Nom</th>
                        <th>Téléphone</th>
                        <th>Email</th>
                        <th class="text-nowrap" style="min-width: 90px;">Actif</th>
                        <th class="text-nowrap">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                        <tr>
                            <td class="text-nowrap">{{ user.campus ? user.campus.nom : '' }}</td>
                            <td>{{ user.pseudo }}</td>
                            <td>{{ user.prenom }}</td>
                            <td>{{ user.nom }}</td>
                            <td class="text-nowrap">{{ user.telephone }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.actif ? 'Oui' : 'Non' }}</td>
                            <td class="text-nowrap">
                                <div class="d-flex gap-1">
                                    <a href="{{ path('app_admin_users_edit', {'id': user.id}) }}"
                                       class="btn btn-sm btn-primary">Modifier</a>
                                    <a href="{{ path('app_admin_users_delete', {'id': user.id}) }}"
                                       class="btn btn-sm btn-danger">Supprimer</a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}

                    {# Ligne pour l'ajout d'un nouvel utilisateur #}
                    <tr>
                        <td>
                            <input type="text" name="nameCampus" class="form-control form-control-sm"
                                   placeholder="Nom du campus" required>
                        </td>
                        <td>
                            <input type="text" name="pseudo" class="form-control form-control-sm" placeholder="Pseudo"
                                   required>
                        </td>
                        <td>
                            <input type="text" name="firstName" class="form-control form-control-sm"
                                   placeholder="Prénom" required>
                        </td>
                        <td>
                            <input type="text" name="lastName" class="form-control form-control-sm" placeholder="Nom"
                                   required>
                        </td>

                        <td>
                            <input type="text" name="phone" class="form-control form-control-sm" placeholder="Téléphone"
                                   required>
                        </td>
                        <td>
                            <input type="email" name="email" class="form-control form-control-sm" placeholder="Email"
                                   required>
                        </td>
                        <td>
                            <select name="activeStatus" class="form-select form-select-sm" style="min-width: 85px;">
                                <option value="1">Oui</option>
                                <option value="0">Non</option>
                            </select>
                        </td>
                        <td class="text-nowrap">
                            <button type="submit" class="btn btn-sm btn-success w-100">Ajouter</button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </form>
    </div>
{% endblock %}
