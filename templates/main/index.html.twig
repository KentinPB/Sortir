{% extends 'base.html.twig' %}

{% block title %}Liste des sorties{% endblock %}

{% block body %}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start mb-3 gap-2">
        <h1>Liste des sorties</h1>
        <div class="text-md-end text-muted">
            <div>Date du jour : {{ "now"|date('d/m/Y') }}</div>
            {% if app.user %}
                <div>Participant : {{ app.user.prenom }} {{ app.user.nom }}</div>
            {% endif %}
        </div>
    </div>

    <div class="card card-form mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">

                <div class="col-12">
                    <div class="d-flex flex-wrap gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="estOrganisateur" value="1"
                                   id="estOrganisateur"
                                   {% if app.request.query.get('estOrganisateur') %}checked{% endif %}>
                            <label class="form-check-label" for="estOrganisateur">Sorties dont je suis
                                l'organisateur/trice</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="estInscrit" value="1" id="estInscrit"
                                   {% if app.request.query.get('estInscrit') %}checked{% endif %}>
                            <label class="form-check-label" for="estInscrit">Sorties auxquelles je suis
                                inscrit/e</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="estNonInscrit" value="1"
                                   id="estNonInscrit"
                                   {% if app.request.query.get('estNonInscrit') %}checked{% endif %}>
                            <label class="form-check-label" for="estNonInscrit">Sorties auxquelles je ne suis pas
                                inscrit/e</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="sortiesTerminees" value="1"
                                   id="sortiesTerminees"
                                   {% if app.request.query.get('sortiesTerminees') %}checked{% endif %}>
                            <label class="form-check-label" for="sortiesTerminees">Sorties terminées</label>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label">Nom de la sortie</label>
                    <input type="text" name="nom" class="form-control" placeholder="Rechercher..."
                           value="{{ app.request.query.get('nom') }}">
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Du</label>
                    <input type="date" name="dateDebut" class="form-control"
                           value="{{ app.request.query.get('dateDebut') }}">
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Au</label>
                    <input type="date" name="dateFin" class="form-control"
                           value="{{ app.request.query.get('dateFin') }}">
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Campus</label>
                    <select name="campus" class="form-select">
                        <option value="">Tous les campus</option>
                        {% for c in campusList %}
                            <option value="{{ c.id }}"
                                    {% if app.request.query.get('campus') == c.id %}selected{% endif %}>
                                {{ c.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filtrer</button>
                </div>

            </form>
        </div>
    </div>

    {% set etatColors = {
        'Ouverte': 'success',
        'Clôturée': 'warning',
        'En cours': 'info',
        'Terminée': 'secondary',
        'Annulée': 'danger',
        'En création': 'light text-dark'
    } %}

    {# ===================== VISTA DE TARJETAS - solo en móvil (< md) ===================== #}
    <div class="d-md-none">
        {% for sortie in sorties %}
            {% set estOrganisateur = app.user and sortie.organisateur == app.user %}
            {% set estInscrit = app.user and sortie.participants.contains(app.user) %}
            <div class="card mb-2">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                        <h5 class="card-title mb-0">{{ sortie.nom }}</h5>
                        <span class="badge bg-{{ etatColors[sortie.etat.libelle]|default('secondary') }} text-nowrap">
                            {{ sortie.etat.libelle }}
                        </span>
                    </div>

                    <p class="card-text mb-1 text-muted">{{ sortie.dateHeureDebut|date('d/m/Y H:i') }}</p>

                    <p class="card-text mb-1">
                        Clôture : {{ sortie.dateLimiteInscription|date('d/m/Y') }}
                    </p>

                    <p class="card-text mb-1">
                        {{ sortie.participants|length }}/{{ sortie.nbInscriptionsMax }} inscrits
                        {% if estInscrit %} · <strong>Inscrit(e)</strong>{% endif %}
                    </p>

                    <p class="card-text mb-2">
                        Organisateur :
                        <a href="{{ path('app_profile_show', {id: sortie.organisateur.id}) }}">
                            {{ sortie.organisateur.prenom }} {{ sortie.organisateur.nom|slice(0, 1) }}.
                        </a>
                    </p>

                    <div class="d-flex flex-wrap gap-1">
                        <a href="{{ path('sortie_afficher', {id: sortie.id}) }}" class="btn btn-sm btn-outline-info">Afficher</a>
                        {% if estOrganisateur %}
                            {% if sortie.etat.libelle == 'En création' %}
                                <a href="{{ path('app_sortie_modifier', {id: sortie.id}) }}"
                                   class="btn btn-sm btn-outline-warning">Modifier</a>
                                <a href="{{ path('app_sortie_modifier', {id: sortie.id}) }}"
                                   class="btn btn-sm btn-outline-success">Publier</a>
                            {% elseif sortie.etat.libelle in ['Ouverte', 'Clôturée'] %}
                                {% if estInscrit %}
                                    <a href="{{ path('sortie_desister', {id: sortie.id}) }}"
                                       class="btn btn-sm btn-outline-secondary">Se désister</a>
                                {% elseif sortie.etat.libelle == 'Ouverte' %}
                                    <a href="{{ path('sortie_inscrire', {id: sortie.id}) }}"
                                       class="btn btn-sm btn-outline-primary">S'inscrire</a>
                                {% endif %}
                                <a href="{{ path('app_sortie_annuler', {id: sortie.id}) }}"
                                   class="btn btn-sm btn-outline-danger">Annuler</a>
                            {% endif %}
                        {% else %}
                            {% if sortie.etat.libelle in ['Ouverte', 'Clôturée'] %}
                                {% if estInscrit %}
                                    <a href="{{ path('sortie_desister', {id: sortie.id}) }}"
                                       class="btn btn-sm btn-outline-secondary">Se désister</a>
                                {% elseif sortie.etat.libelle == 'Ouverte' %}
                                    <a href="{{ path('sortie_inscrire', {id: sortie.id}) }}"
                                       class="btn btn-sm btn-outline-primary">S'inscrire</a>
                                {% endif %}
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <p class="text-muted">Aucune sortie trouvée.</p>
        {% endfor %}
    </div>

    {# ===================== VISTA DE TABLA - solo desde tablet/desktop (>= md) ===================== #}
    <div class="table-responsive d-none d-md-block">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
            <tr>
                <th>Nom de la sortie</th>
                <th>Date de la sortie</th>
                <th>Clôture</th>
                <th>Inscrits/Places</th>
                <th>Etat</th>
                <th class="text-center">Inscrit</th>
                <th>Organisateur</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for sortie in sorties %}
                {% set estOrganisateur = app.user and sortie.organisateur == app.user %}
                {% set estInscrit = app.user and sortie.participants.contains(app.user) %}
                <tr>
                    <td>{{ sortie.nom }}</td>
                    <td>{{ sortie.dateHeureDebut|date('d/m/Y H:i') }}</td>
                    <td>{{ sortie.dateLimiteInscription|date('d/m/Y') }}</td>
                    <td>{{ sortie.participants|length }}/{{ sortie.nbInscriptionsMax }}</td>
                    <td>
                        <span class="badge bg-{{ etatColors[sortie.etat.libelle]|default('secondary') }}">
                            {{ sortie.etat.libelle }}
                        </span>
                    </td>
                    <td class="text-center fw-bold">
                        {% if estInscrit %}X{% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_profile_show', {id: sortie.organisateur.id}) }}">
                            {{ sortie.organisateur.prenom }} {{ sortie.organisateur.nom|slice(0, 1) }}.
                        </a>
                    </td>
                    <td class="d-flex flex-wrap gap-1">
                        <a href="{{ path('sortie_afficher', {id: sortie.id}) }}" class="btn btn-sm btn-outline-info">Afficher</a>
                        {% if estOrganisateur %}
                            {% if sortie.etat.libelle == 'En création' %}
                                <a href="{{ path('app_sortie_modifier', {id: sortie.id}) }}"
                                   class="btn btn-sm btn-outline-warning">Modifier</a>
                                <a href="{{ path('app_sortie_modifier', {id: sortie.id}) }}"
                                   class="btn btn-sm btn-outline-success">Publier</a>
                            {% elseif sortie.etat.libelle in ['Ouverte', 'Clôturée'] %}
                                {% if estInscrit %}
                                    <a href="{{ path('sortie_desister', {id: sortie.id}) }}"
                                       class="btn btn-sm btn-outline-secondary">Se désister</a>
                                {% elseif sortie.etat.libelle == 'Ouverte' %}
                                    <a href="{{ path('sortie_inscrire', {id: sortie.id}) }}"
                                       class="btn btn-sm btn-outline-primary">S'inscrire</a>
                                {% endif %}
                                <a href="{{ path('app_sortie_annuler', {id: sortie.id}) }}"
                                   class="btn btn-sm btn-outline-danger">Annuler</a>
                            {% endif %}
                        {% else %}
                            {% if sortie.etat.libelle in ['Ouverte', 'Clôturée'] %}
                                {% if estInscrit %}
                                    <a href="{{ path('sortie_desister', {id: sortie.id}) }}"
                                       class="btn btn-sm btn-outline-secondary">Se désister</a>
                                {% elseif sortie.etat.libelle == 'Ouverte' %}
                                    <a href="{{ path('sortie_inscrire', {id: sortie.id}) }}"
                                       class="btn btn-sm btn-outline-primary">S'inscrire</a>
                                {% endif %}
                            {% endif %}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mb-3">
        <a href="{{ path('app_sortie_creer') }}" class="btn btn-success">Créer une sortie</a>
    </div>
{% endblock %}


