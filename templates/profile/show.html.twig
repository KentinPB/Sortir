{% extends 'base.html.twig' %}

{% block title %}Profil de {{ participant.pseudo }}{% endblock %}

{% block body %}

<div class="container mt-4">

    {# TODO: Déplacer ce style inline dans app.css en créant une classe .profile-photo #}
    {# TODO: Factoriser l'affichage des photos et des avatars dans un template partagé #}
    <div class="row">

        <!--Colonne Photo -->
        <div class="profile-photo col-md-3">
            {%  if participant.photo %}
            <img src="{{ asset('uploads/photos/'~participant.photo) }}"
                 alt="Photo de {{ participant.pseudo }}"
                 class="img-fluid rounded border"
                 style="width:240px; height:180px; object-fit:contain;">
            {% else %}
            <img src="{{ asset('images/default-avatar.png') }}"
                 alt="Photo par défaut"
                 class="img-fluid rounded border"
                 style="width:240px; height:180px; object-fit:contain;">
            {% endif %}
        </div>

        <!-- Colonne détails -->
        <div class="profile-form-col col-md-9">

            <h2 class="mb-4">{{ participant.pseudo }}</h2>
            <div class="row mb-2">
                <div class="col-3 fw-semibold">Campus</div>
                <div class="col">{{ participant.campus.nom }}</div>
            </div>

            <div class="row mb-2">
                <div class="col-3 fw-semibold">Prénom</div>
                <div class="col">{{ participant.prenom }}</div>
            </div>
            <div class="row mb-2">
                <div class="col-3 fw-semibold">Nom</div>
                <div class="col">{{ participant.nom }}</div>
            </div>
            <div class="row mb-2">
                <div class="col-3 fw-semibold">Téléphone</div>
                <div class="col">{{ participant.telephone }}</div>
            </div>
            <div class="row mb-2">
                <div class="col-3 fw-semibold">Email</div>
                <div class="col">{{ participant.email }}</div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
