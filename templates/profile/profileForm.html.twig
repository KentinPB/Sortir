{% extends 'base.html.twig' %}

{% block title %}
    {% if form.campus is defined %}
        {% if participant.id %}
            Modifier le profil de {{ participant.pseudo }}
        {% else %}
            Créer un nouvel utilisateur
        {% endif %}
    {% else %}
        Mon profil
    {% endif %}
{% endblock %}

{% block body %}

    <div class="container mt-4">

        <h1 class="mb-4">
            {% if form.campus is defined %}
                {% if participant.id %}
                    Modifier le profil de {{ participant.pseudo }}
                {% else %}
                    Créer un nouvel utilisateur
                {% endif %}
            {% else %}
                Mon profil
            {% endif %}
        </h1>

        {{ form_start(form) }}

        {# Si l'admin est sur la page, on affiche la liste déroulante du Campus #}
        {% if form.campus is defined %}
            {{ form_row(form.campus) }}
            {% if form.actif is defined %}
                {{ form_row(form.actif) }}
            {% endif %}
        {% else %}
            {# Pour un utilisateur classique, le campus reste en lecture seule #}
            <div class="mb-3">
                <label class="form-label">Campus</label>
                <input
                    type="text"
                    class="form-control"
                    value="{{ participant.campus ? participant.campus.nom : 'Non renseigné' }}"
                    disabled>
            </div>
        {% endif %}

        {{ form_row(form.pseudo) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.prenom) }}
        {{ form_row(form.telephone) }}
        {{ form_row(form.email) }}
        {{ form_errors(form.plainPassword) }}
        {{ form_row(form.plainPassword.first) }}
        {{ form_row(form.plainPassword.second) }}

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            {% if form.campus is defined %}
                <a href="{{ path('app_admin_users_list') }}" class="btn btn-secondary ms-2">Annuler</a>
            {% endif %}
        </div>

        {{ form_end(form) }}

    </div>
{% endblock %}
